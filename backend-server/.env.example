# Required / 必填: PostgreSQL connection string (Prisma datasource)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_chat_rag?schema=public"

# Required / 必填: Secret used to sign and verify JWTs; startup fails if blank
JWT_SECRET="replace-with-a-long-random-secret"

# Optional, has default / 可选，有默认值: JWT lifetime
JWT_EXPIRES_IN=7d

# Required / 必填: Comma-separated allowed browser origins for CORS
CLIENT_ORIGIN="http://localhost:5173"

# Required / 必填: Shared secret shared with AI-server; startup fails if blank
AI_SERVICE_SHARED_SECRET="replace-with-the-same-secret-as-ai-server"

# Optional, has default / 可选，有默认值: Service port
PORT=3001

# Optional, has default / 可选，有默认值: AI service base URL
AI_SERVICE_BASE_URL=http://127.0.0.1:8000

# Optional, has default / 可选，有默认值: Single file upload size limit in MB
UPLOAD_MAX_FILE_SIZE_MB=20

# Optional, has default / 可选，有默认值: Upstream AI service timeout in milliseconds
AI_SERVICE_TIMEOUT_MS=12000

# Optional override / 可选覆盖: Full ingestion endpoint URL
AI_INGESTION_ENDPOINT=

# Optional override / 可选覆盖: Full vector delete endpoint prefix URL
AI_VECTOR_DELETE_ENDPOINT=

# Optional, has default / 可选，有默认值: Ingestion recovery options
INGESTION_RUNNING_TIMEOUT_MS=300000
INGESTION_POLL_INTERVAL_MS=10000
INGESTION_RETRY_BASE_MS=1000
INGESTION_RETRY_MAX_MS=60000
INGESTION_MAX_ATTEMPTS=8
