# Copy to .env before running docker compose up

# PostgreSQL
POSTGRES_USER=ai_chat_rag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ai_chat_rag

# Backend auth (required)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Shared secret between backend and AI-server (required, must be identical)
AI_SERVICE_SHARED_SECRET=replace-with-another-long-random-string

# Browser origin allowed by CORS
CLIENT_ORIGIN=http://localhost:8080

# AI-server model keys
ZHIPUAI_API_KEY=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_BASE_URL=
