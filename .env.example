# 复制为 .env 后运行：docker compose up -d --build
# 注意：模型 API Key 也可在 Web 管理后台填写；这里的环境变量作为兜底默认值。

# ---------- PostgreSQL ----------
POSTGRES_USER=ai_chat_rag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ai_chat_rag

# ---------- 安全密钥（必填，请改成随机长字符串） ----------
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
AI_SERVICE_SHARED_SECRET=replace-with-another-long-random-string

# ---------- 初始管理员（必填；首次启动自动创建，之后幂等） ----------
# 手机号格式：1 开头 11 位；初始密码至少 8 位
BOOTSTRAP_ADMIN_PHONE=13800138000
BOOTSTRAP_ADMIN_PASSWORD=change-me-123
# 仅当你确实需要通过环境变量重置管理员密码时改为 true，重置后建议改回 false
BOOTSTRAP_ADMIN_RESET_PASSWORD=false

# ---------- 浏览器来源（CORS 白名单） ----------
CLIENT_ORIGIN=http://localhost:8080

# ---------- 模型参数兜底（可选；后台配置优先） ----------
# LLM（聊天）：任意 OpenAI 兼容服务
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=
# Embedding（入库）：zhipu 或 openai
ZHIPUAI_API_KEY=
EMBEDDING_PROVIDER=zhipu
ZHIPUAI_EMBEDDING_MODEL=embedding-3
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------- RAG 参数兜底（可选；后台配置优先） ----------
CHAT_RETRIEVAL_TOP_K=5
CHAT_RETRIEVAL_SCORE_THRESHOLD=0.35
CHAT_CONTEXT_MESSAGE_LIMIT=8
INGEST_CHUNK_SIZE=800
INGEST_CHUNK_OVERLAP=120
EMBEDDING_BATCH_SIZE=64
